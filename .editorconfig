root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = false

# Matches multiple files with brace expansion notation
# Set default charset
[*.{js,py,nix,json}]
charset = utf-8
indent_style = space
indent_size = 2

[*.{yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2